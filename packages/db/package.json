{
  "name": "@consultancy/db",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node ../../scripts/start-db.mjs",
    "db:push": "dotenvx run --env-file=../../.env -- drizzle-kit push",
    "db:generate": "dotenvx run --env-file=../../.env -- drizzle-kit generate",
    "db:apply-migrations": "dotenvx run --env-file=../../.env -- drizzle-kit apply",
    "db:start": "set -a && [ -f ../../.env ] && . ../../.env; docker run --name consultancy_hub -e POSTGRES_USER=$DB_USER -e POSTGRES_PASSWORD=$DB_PASSWORD -e POSTGRES_DB=$DB_NAME -d -p 5432:5432 postgres",
    "db:view": "dotenvx run --env-file=../../.env -- drizzle-kit studio",
    "db:seed": "dotenvx run --env-file=../../.env -- tsx src/scripts/seed-reference-data.ts",
    "db:seed-test-data":  "dotenvx run --env-file=../../.env -- tsx src/scripts/dev/fixtures.ts",
    "db:seed-dev": "dotenvx run --env-file=../../.env -- tsx src/scripts/dev/seed-dev-data.ts",
    "db:seed-endorsement-batch": "dotenvx run --env-file=../../.env -- tsx src/scripts/dev/seed-endorsement-batch.ts",
    "db:seed-my-user": "dotenvx run --env-file=../../.env -- tsx src/scripts/dev/seed-my-user.ts",
    "db:dbml": "tsx src/scripts/generate-dbml.ts",
    "build": "tsc --outDir dist --declaration false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.1",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.8"
  }
}
