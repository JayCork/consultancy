enum competency_disposition {
  seeking
  neutral
  open
  winding_down
  prefer_not
}

enum competency_proficiency {
  aware
  practising
  confident
  leading
}

enum competency_source {
  verified_evidence
  self_reported
  imported
}

enum competency_type {
  technology
  practice
  methodology
}

enum data_classification {
  public
  official
  official_sensitive
  secret
}

enum endorsement_routing_policy {
  project_and_managers
  project_only
  managers_only
}

enum endorsement_status {
  pending
  endorsed
  skipped
  flagged
}

enum evidence_status {
  draft
  submitted
  verified
}

enum feedback_visibility {
  pending_review
  approved
  rejected
  published
}

enum framework_level {
  associate
  junior
  mid
  senior
  lead
  principal
}

enum goal_status {
  active
  achieved
  abandoned
}

enum goal_visibility {
  private
  shared_with_manager
}

enum invitation_status {
  pending
  accepted
  expired
  revoked
}

enum platform_role {
  member
  leadership_team
  admin
}

enum project_funding_model {
  time_and_materials
  fixed_price
  capped_time_and_materials
  retainer
}

enum project_role {
  developer
  tech_lead
  delivery_manager
  analyst
  designer
  project_manager
}

enum project_status {
  opportunity
  qualifying
  bidding
  bid_submitted
  bid_won
  bid_lost
  contract_review
  contract_signed
  mobilising
  discovery
  in_delivery
  uat
  hypercare
  support
  contract_renewal
  closing
  closed
  cancelled
}

enum region {
  GBR
  USA
  CAN
  AUS
  NZL
  IRL
}

enum tag_type {
  technology
  tool
  practice
  methodology
  domain
}

enum user_relationship_type {
  line_manager
  technical_manager
  mentor
  mentee
  peer
}

enum user_status {
  pending_org
  pending_approval
  active
  suspended
}

table bauth_accounts {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    user_id [name: 'account_userId_idx']
  }
}

table clearance_levels {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  shortName text [not null]
  rank integer [not null, unique]
  description text
  region region [not null, default: 'GBR']
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (region, rank) [name: 'clearance_levels_region_rank_unique', unique]
    (region, name) [name: 'clearance_levels_region_name_unique', unique]
  }
}

table competencies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  skill_id uuid [not null]
  organization_id uuid [not null]
  proficiency competency_proficiency [not null]
  disposition competency_disposition [not null, default: 'neutral']
  disposition_note text
  source competency_source [not null, default: 'self_reported']
  last_used_at date
  external_id text
  external_source text
  created_at "timestamp (6)" [not null, default: `now()`]
  updated_at "timestamp (6)"

  indexes {
    (user_id, skill_id) [name: 'competencies_user_skill_unique', unique]
  }
}

table credentials {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  name text [not null]
  issuer text [not null]
  issued_at date
  expires_at date
  credential_url text
  external_id text
  external_source text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table endorsements {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  evidence_id uuid [not null]
  endorser_id uuid [not null]
  is_suggested boolean [not null, default: true]
  status endorsement_status [not null, default: 'pending']
  note text
  responded_at timestamp
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (evidence_id, endorser_id) [name: 'endorsements_evidence_endorser_unique', unique]
  }
}

table evidence_skills {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  evidence_id uuid [not null]
  skill_id uuid [not null]
  level_claimed framework_level [not null]
  is_primary boolean [not null, default: false]
  created_at "timestamp (6)" [not null, default: `now()`]
  updated_at "timestamp (6)"

  indexes {
    (evidence_id, skill_id) [name: 'evidence_skills_unique', unique]
  }
}

table evidence {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  project_id uuid
  parent_id uuid
  version integer [not null, default: 1]
  situation text [not null]
  task text [not null]
  action text [not null]
  result text [not null]
  status evidence_status [not null, default: 'draft']
  data_classification data_classification [not null, default: 'official']
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table evidence_tags {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  evidence_id uuid [not null]
  tag_id uuid [not null]
  created_at "timestamp (6)" [not null, default: `now()`]

  indexes {
    (evidence_id, tag_id) [name: 'evidence_tags_unique', unique]
  }
}

table feedback {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  author_id uuid [not null]
  subject_id uuid
  project_id uuid
  reviewed_by_id uuid
  is_anonymous boolean [not null, default: false]
  visibility feedback_visibility [not null, default: 'pending_review']
  content text [not null]
  organization_id uuid [not null]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table framework_role_families {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid
  name text [not null]
  description text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table framework_role_mappings {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  framework_role_id uuid [not null]
  reference_role_id uuid [not null]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table framework_role_skill_expectations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  framework_role_id uuid [not null]
  skill_id uuid [not null]
  minimum_level framework_level [not null]
  is_primary boolean [not null, default: false]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (framework_role_id, skill_id) [name: 'frse_role_skill_unique', unique]
  }
}

table framework_roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid
  family_id uuid [not null]
  level framework_level [not null]
  display_name text [not null]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table goal_evidence {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  goal_id uuid [not null]
  evidence_id uuid [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (goal_id, evidence_id) [name: 'goal_evidence_unique', unique]
  }
}

table goals {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  title text [not null]
  description text
  target_date date
  status goal_status [not null, default: 'active']
  visibility goal_visibility [not null, default: 'private']
  target_role_id uuid
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table invitations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  email varchar [not null]
  token text [not null, unique]
  status invitation_status [not null, default: 'pending']
  invited_by uuid [not null]
  expires_at timestamp [not null]
  accepted_at timestamp
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table job_grades {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  framework_role_id uuid [not null]
  name text [not null]
  external_id text
  external_source text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table organization_units {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  parent_id uuid
  name text [not null]
  unit_type text [not null]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (organization_id, name) [name: 'organization_units_organization_id_name_unique', unique]
    
  }
}

table organizations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  promotion_threshold integer [not null, default: 80]
  endorsements_required integer [not null, default: 2]
  endorsement_routing_policy endorsement_routing_policy [not null, default: 'project_and_managers']
  feedback_review_required boolean [not null, default: true]
  external_id text
  external_source text
  region region [not null, default: 'GBR']
  target_margin_pct "numeric(5, 2)" [not null, default: '30.00']
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (external_source, external_id) [name: 'organizations_external_source_external_id_unique', unique]
  }
}

table pay_bands {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  job_grade_id uuid [not null]
  band_floor "numeric(10, 2)" [not null]
  band_ceiling "numeric(10, 2)" [not null]
  currency varchar(3) [not null, default: 'GBP']
  effective_from date [not null]
  effective_to date
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table project_members {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  user_id uuid [not null]
  projectRole project_role [not null]
  job_grade_id uuid
  allocated_hours_per_week "numeric(5, 2)"
  start_date timestamp [not null]
  end_date timestamp

  indexes {
    (project_id, user_id) [name: 'project_members_active_unique', unique]
  }
}

table project_milestones {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  label text [not null]
  notes text
  date date [not null]
  created_by uuid [not null]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table projects {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  lead_id uuid [not null]
  name text [not null]
  short_name text
  code_name varchar(8)
  organization_unit_id uuid [not null]
  minimum_clearance_id uuid
  funding_model project_funding_model [not null, default: 'time_and_materials']
  contracted_value "numeric(12, 2)"
  currency varchar(3) [not null, default: 'GBP']
  margin_override_pct "numeric(5, 2)"
  start_date timestamp [not null]
  end_date timestamp
  region region [not null, default: 'GBR']
  status project_status [not null, default: 'opportunity']
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    code_name [name: 'projects_code_name_unique', unique]
  }
}

table reference_frameworks {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  version text
  url text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table reference_roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  framework_id uuid [not null]
  code text
  name text [not null]
  description text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table reference_skills {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  framework_id uuid [not null]
  code text [not null]
  name text [not null]
  description text
  min_level integer [not null, default: 0]
  max_level integer [not null, default: 7]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table resource_scenario_assignments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  scenario_id uuid [not null]
  user_id uuid
  project_role project_role [not null]
  job_grade_id uuid [not null]
  allocated_hours_per_week "numeric(5, 2)" [not null]
  start_date date [not null]
  end_date date
  notes text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table resource_scenarios {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  name text [not null]
  description text
  created_by uuid [not null]
  committed_at "timestamp with time zone"
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table bauth_sessions {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

table skill_framework_mappings {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  skill_id uuid [not null]
  reference_skill_id uuid [not null]
  notes text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table skill_levels {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  skill_id uuid [not null]
  level framework_level [not null]
  description text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (skill_id, level) [name: 'skill_levels_skill_level_unique', unique]
  }
}

table skills {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid
  name text [not null]
  description text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (organization_id, name) [name: 'skills_org_name_unique', unique]
  }
}

table bauth_sso_providers {
  id text [pk, not null]
  issuer text [not null]
  oidc_config text
  saml_config text
  user_id text
  provider_id text [not null, unique]
  organization_id text
  domain text [not null]
}

table tags {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid
  name text [not null]
  tag_type tag_type [not null]
  notes text
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (organization_id, name) [name: 'tags_org_name_unique', unique]
  }
}

table bauth_users {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table user_clearances {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  clearance_level_id uuid [not null]
  granted_at timestamp [not null]
  expires_at timestamp
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table user_grade_assignments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  job_grade_id uuid [not null]
  start_date date [not null]
  end_date date
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table user_relationships {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  actor_id uuid [not null]
  target_id uuid [not null]
  relationship_type user_relationship_type [not null]
  start_date date [not null]
  end_date date
  organization_id uuid [not null]
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"
}

table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  status user_status [not null, default: 'pending_org']
  organization_id uuid
  name text [not null]
  email text [not null, unique]
  external_id text
  external_source text
  better_auth_id text [not null, unique]
  contracted_hours_per_week smallint
  platform_role platform_role [not null, default: 'member']
  updated_at "timestamp (6)"
  created_at "timestamp (6)" [not null, default: `now()`]
  deleted_at "timestamp (6)"

  indexes {
    (organization_id, external_source, external_id) [name: 'users_org_external_unique', unique]
  }
}

table bauth_verifications {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

ref bauth_accounts_user_id_bauth_users_id_fk: bauth_accounts.user_id > bauth_users.id [delete: cascade, update: no action]

ref competencies_user_id_users_id_fk: competencies.user_id > users.id [delete: no action, update: no action]

ref competencies_skill_id_skills_id_fk: competencies.skill_id > skills.id [delete: no action, update: no action]

ref competencies_organization_id_organizations_id_fk: competencies.organization_id > organizations.id [delete: no action, update: no action]

ref credentials_user_id_users_id_fk: credentials.user_id > users.id [delete: no action, update: no action]

ref endorsements_evidence_id_evidence_id_fk: endorsements.evidence_id > evidence.id [delete: no action, update: no action]

ref endorsements_endorser_id_users_id_fk: endorsements.endorser_id > users.id [delete: no action, update: no action]

