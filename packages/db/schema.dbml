ref evidence_skills_skill_id_skills_id_fk: evidence_skills.skill_id > skills.id [delete: no action, update: no action]

ref evidence_user_id_users_id_fk: evidence.user_id > users.id [delete: no action, update: no action]

ref evidence_project_id_projects_id_fk: evidence.project_id > projects.id [delete: no action, update: no action]

ref evidence_parent_id_evidence_id_fk: evidence.parent_id > evidence.id [delete: no action, update: no action]

ref evidence_tags_evidence_id_evidence_id_fk: evidence_tags.evidence_id > evidence.id [delete: no action, update: no action]

ref evidence_tags_tag_id_tags_id_fk: evidence_tags.tag_id > tags.id [delete: no action, update: no action]

ref feedback_author_id_users_id_fk: feedback.author_id > users.id [delete: no action, update: no action]

ref feedback_subject_id_users_id_fk: feedback.subject_id > users.id [delete: no action, update: no action]

ref feedback_project_id_projects_id_fk: feedback.project_id > projects.id [delete: no action, update: no action]

ref feedback_reviewed_by_id_users_id_fk: feedback.reviewed_by_id > users.id [delete: no action, update: no action]

ref feedback_organization_id_organizations_id_fk: feedback.organization_id > organizations.id [delete: no action, update: no action]

ref framework_role_families_organization_id_organizations_id_fk: framework_role_families.organization_id > organizations.id [delete: no action, update: no action]

ref framework_role_mappings_framework_role_id_framework_roles_id_fk: framework_role_mappings.framework_role_id > framework_roles.id [delete: no action, update: no action]

ref framework_role_mappings_reference_role_id_reference_roles_id_fk: framework_role_mappings.reference_role_id > reference_roles.id [delete: no action, update: no action]

ref framework_role_skill_expectations_framework_role_id_framework_roles_id_fk: framework_role_skill_expectations.framework_role_id > framework_roles.id [delete: no action, update: no action]

ref framework_role_skill_expectations_skill_id_skills_id_fk: framework_role_skill_expectations.skill_id > skills.id [delete: no action, update: no action]

ref framework_roles_organization_id_organizations_id_fk: framework_roles.organization_id > organizations.id [delete: no action, update: no action]

ref framework_roles_family_id_framework_role_families_id_fk: framework_roles.family_id > framework_role_families.id [delete: no action, update: no action]

ref goal_evidence_goal_id_goals_id_fk: goal_evidence.goal_id > goals.id [delete: no action, update: no action]

ref goal_evidence_evidence_id_evidence_id_fk: goal_evidence.evidence_id > evidence.id [delete: no action, update: no action]

ref goals_user_id_users_id_fk: goals.user_id > users.id [delete: no action, update: no action]

ref goals_target_role_id_framework_roles_id_fk: goals.target_role_id > framework_roles.id [delete: no action, update: no action]

ref invitations_organization_id_organizations_id_fk: invitations.organization_id > organizations.id [delete: no action, update: no action]

ref invitations_invited_by_users_id_fk: invitations.invited_by > users.id [delete: no action, update: no action]

ref job_grades_organization_id_organizations_id_fk: job_grades.organization_id > organizations.id [delete: no action, update: no action]

