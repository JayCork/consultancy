// =============================================================================
// Contractor Hub — Database Schema v2
// =============================================================================
//
// DEPLOYMENT MODELS
// This schema supports two deployment modes without structural changes:
//
//   Hosted (multi-tenant SaaS)
//     Multiple organisations share one database, isolated by organisation_id
//     and PostgreSQL Row-Level Security.
//
//   Self-hosted (single-tenant)
//     Client deploys in their own infrastructure. Typically one organisation
//     row. Reference data (SFIA, DDaT, clearance_levels) is seeded at deploy
//     time from the same seed scripts used in hosted mode.
//
// REFERENCE DATA vs TENANT DATA
// Tables with a nullable organisation_id follow this convention:
//   organisation_id IS NULL     → global reference data (seeded at deploy time,
//                                 visible to all organisations, not editable)
//   organisation_id IS NOT NULL → tenant-defined extension (created by the
//                                 organisation to cover gaps in the framework)
//
// EXTERNAL INTEGRATIONS
// external_id + external_source fields are present on key tables to support
// future integrations with BambooHR, Okta, Azure AD, Pluralsight, and similar.
// Both fields are nullable — records created manually have neither set.
// Intended unique constraint: (organisation_id, external_source, external_id)
// where applicable, to prevent duplicate imports.
//
// COMPETENCY DIMENSIONS
// Three distinct dimensions describe what a person knows and can do:
//
//   SFIA skills        what you can do at a capability level (formally levelled)
//   competencies       how you work and what you know outside the framework:
//                        technology  — tools, languages, platforms (recency-sensitive)
//                        practice    — ways of working, e.g. TDD, pair programming
//                        methodology — broader approaches, e.g. Scrum, Design Thinking
//   credentials        third-party verified certifications and qualifications
//
// =============================================================================


// ── Reference data (global, seeded at deploy time) ────────────────────────

Table clearance_levels {
  id           int  [primary key]
  name         text [not null, note: 'e.g. BPSS, CTC, SC, DV, DV+']
  rank         int  [not null, unique,
                     note: '1=BPSS 2=CTC 3=SC 4=DV — higher rank = higher clearance']
  description  text
  note: 'Global reference data. Never organisation-specific. Seeded at deploy time.'
}

Table sfia_skills {
  id               int  [primary key]
  organisation_id  int  [ref: > organisations.id,
                          note: 'NULL = global SFIA reference data.
                          Non-null = org-defined custom skill covering a gap in the framework.']
  name             text [not null, note: 'e.g. Software Development']
  code             text [not null, note: 'e.g. PROG — unique within a framework version']
  category         text [not null, note: 'e.g. Development and Implementation']
  subcategory      text
  description      text
  note: 'Rows with organisation_id NULL are seeded global SFIA v9 data.
  Organisations may add custom skills by inserting rows with their own organisation_id.'
}

Table sfia_skill_levels {
  id               int  [primary key]
  sfia_skill_id    int  [not null, ref: > sfia_skills.id]
  organisation_id  int  [ref: > organisations.id,
                          note: 'Mirrors parent skill. NULL for global, non-null for org-defined.']
  level_number     int  [not null, note: '1-7 for SFIA. Custom skills may use any range.']
  description      text [not null, note: 'Behavioural indicators for this skill at this level.']
}

Table ddat_roles {
  id     int  [primary key]
  name   text [not null, note: 'e.g. Software Developer, Senior Data Analyst']
  family text [not null, note: 'e.g. Engineering, Data, Product and Delivery']
  level  int  [not null, note: '1=Apprentice 2=Junior 3=Mid 4=Senior 5=Lead 6=Principal']
  note: 'Global reference data from the UK DDaT Profession Capability Framework.
  Not extendable by organisations — map to it or define custom requirements instead.'
}

Table ddat_role_requirements {
  id                  int [primary key]
  ddat_role_id        int [not null, ref: > ddat_roles.id]
  sfia_skill_level_id int [not null, ref: > sfia_skill_levels.id]
  note: 'The SFIA skill levels required by each DDaT role.
  Seeded from the official DDaT framework documentation.'
}


// ── Organisations ─────────────────────────────────────────────────────────

Table organisations {
  id                         int   [primary key]
  name                       text  [not null]
  promotion_threshold        int   [not null, default: 80,
                                    note: 'Readiness percentage at which the UI flags promotion eligibility.']
  endorsements_required      int   [not null, default: 2,
                                    note: 'Minimum endorsements to move evidence to verified status.']
  endorsement_routing_policy enum  [not null, default: 'project_and_managers',
                                    note: 'project_only | project_and_managers | managers_only | org_wide
                                    Controls which users receive a pending endorsement row when evidence
                                    is submitted. Authors can always add or remove people manually.']
  feedback_review_required   bool  [not null, default: true,
                                    note: 'If true, all feedback passes through a manager review before
                                    the subject can see it. Strongly recommended when anonymous
                                    feedback is permitted.']
  external_id                text  [note: 'Identifier in the external system (e.g. Okta group ID,
                                    BambooHR company ID). NULL for manually created organisations.']
  external_source            text  [note: 'e.g. okta, bamboohr, azure_ad']

  indexes {
    (external_source, external_id) [unique,
      note: 'Prevents duplicate organisation import from the same source.']
  }
}


// ── Users ─────────────────────────────────────────────────────────────────

Table users {
  id                   int  [primary key]
  organisation_id      int  [not null, ref: > organisations.id]
  name                 text [not null]
  email                text [not null, unique]
  current_clearance_id int  [ref: > user_clearances.id,
                              note: 'Denormalised for fast clearance checks on every project query.
                              Must be kept in sync by the application whenever a user_clearances
                              row is inserted or an existing one expires.
                              NULL = no active clearance (treated as below BPSS for visibility).']
  external_id          text [note: 'Employee ID in the external HR or identity system.
                              e.g. BambooHR employee ID, Okta user ID, Azure AD object ID.']
  external_source      text [note: 'e.g. bamboohr, okta, azure_ad. NULL for manually created users.']

  indexes {
    (organisation_id, external_source, external_id) [unique,
      note: 'Prevents duplicate user import from the same source within an org.']
  }
}

Table user_clearances {
  id                 int  [primary key]
  user_id            int  [not null, ref: > users.id]
  clearance_level_id int  [not null, ref: > clearance_levels.id]
  granted_at         date [not null]
  expires_at         date [note: 'NULL = no expiry (e.g. BPSS). Application should alert before expiry.']
  note: 'Append-only. Never update or delete rows — add a new row if clearance changes.
  users.current_clearance_id points to the most recently granted non-expired row.'
}


// ── Job grades ────────────────────────────────────────────────────────────
//
// An organisation's internal job titles (e.g. "Senior Engineer").
// Each grade either maps to a DDaT role and inherits its SFIA requirements,
// or defines its own requirements via job_grade_requirements.
// Custom requirements in job_grade_requirements are additive when both are set.

Table job_grades {
  id                   int  [primary key]
  organisation_id      int  [not null, ref: > organisations.id]
  name                 text [not null, note: 'Org-defined terminology. e.g. Senior Engineer']
  seniority_level      int  [not null, note: 'Ordinal within this org. Not comparable across orgs.']
  maps_to_ddat_role_id int  [ref: > ddat_roles.id,
                              note: 'NULL = org uses custom requirements via job_grade_requirements.
                              Non-null = inherit DDaT role requirements.']
  external_id          text [note: 'Job grade identifier in the external HR system.']
  external_source      text [note: 'e.g. bamboohr, workday']
}

Table job_grade_requirements {
  id                  int [primary key]
  job_grade_id        int [not null, ref: > job_grades.id]
  sfia_skill_level_id int [not null, ref: > sfia_skill_levels.id]
  note: 'Custom or additive requirements for a job grade.
  When job_grades.maps_to_ddat_role_id is set, these are additive to the DDaT requirements.
  When it is NULL, these are the sole requirements.'
}

Table user_grade_assignments {
  id           int  [primary key]
  user_id      int  [not null, ref: > users.id]
  job_grade_id int  [not null, ref: > job_grades.id]
  assigned_at  date [not null]
  is_current   bool [not null, default: true]
  note: 'Append-only. To change grade, set is_current = false on the existing row
  and insert a new row. This preserves the full grade history.'
}


// ── Competencies ──────────────────────────────────────────────────────────
//
// Covers everything outside SFIA skills that describes how a person works
// and what they know. Three types:
//
//   technology   Tools, languages, platforms. Recency-sensitive. Goes stale.
//                e.g. React, Python, Kubernetes, Salesforce, jQuery
//
//   practice     Ways of working applied within technical or delivery work.
//                e.g. TDD, pair programming, responsive design, SOLID principles,
//                database normalisation, prompt engineering, accessibility auditing,
//                code review, CI/CD discipline, threat modelling
//
//   methodology  Broader approaches and frameworks for delivery or design.
//                e.g. Scrum, SAFe, Design Thinking, Lean UX, ITIL, Prince2,
//                service design, impact mapping, event storming, BPMN
//
// Proficiency scale is deliberately different from technology-only scales.
// It describes the person's relationship to the competency:
//
//   aware        Knows what it is. Limited or no hands-on experience.
//   practising   Actively using it but still developing. Needs guidance sometimes.
//   confident    Applies it independently and reliably without supervision.
//   leading      Coaches others, sets standards, introduces it to teams.
//                This is a meaningful distinction from confident — a leading
//                practitioner of TDD runs workshops and shapes team culture,
//                not just writes tests well.
//
// Disposition captures the person's attitude toward future use.
// This serves two purposes:
//   1. Honest signal for resourcing — avoids placing people on work they resent.
//   2. Organisational insight — if most PHP developers flag prefer_not, that is
//      a signal about capability investment and hiring priorities.
//
// prefer_not is NOT a hard system block. The data model does not prevent
// assignment — it ensures the preference is impossible to miss in any resourcing
// or bid matching context. The human making the decision sees it, acknowledges it,
// and proceeds with full information. Overriding it should be a conversation,
// not a silent decision.

Table competencies {
  id               int  [primary key]
  user_id          int  [not null, ref: > users.id]
  name             text [not null,
                         note: 'e.g. React, TDD, Stakeholder Management, SOLID Principles,
                         Agile Facilitation, Database Normalisation, Prompt Engineering.
                         Should be normalised by the UI via autocomplete to avoid
                         React / ReactJS / React.js fragmentation.']
  competency_type  enum [not null,
                         note: 'technology | practice | methodology']
  proficiency      enum [not null,
                         note: 'aware | practising | confident | leading']
  disposition      enum [not null, default: 'neutral',
                         note: 'seeking | neutral | open | winding_down | prefer_not

                         seeking      Actively wants more work involving this.
                                      Useful signal for project matching and growth conversations.
                                      e.g. "I want to do more Rust" or "I want to facilitate more workshops"

                         neutral      No strong feeling either way. The default state.

                         open         Not actively seeking but would take it on without issue.
                                      Useful distinction from seeking — helps avoid over-assigning
                                      someone to a competency they are merely willing to use.

                         winding_down Willing to use in a supporting or advisory capacity
                                      but does not want to be the lead or primary owner.
                                      e.g. The PHP expert who will help a team debug but does
                                      not want to architect a new PHP system.

                         prefer_not   Has a genuine preference against using this further.
                                      Should be surfaced prominently in any resourcing or bid
                                      matching context. Not a hard block — see note above.']
  disposition_note text [note: 'Optional free text from the user explaining their disposition.
                         e.g. "Happy to advise but have not used this in production since 2019
                         and would need significant ramp-up time. Prefer not to be the lead."
                         Visible to line managers and resource planners. Not publicly visible
                         within the organisation. Users should feel safe being honest here —
                         the note is a tool for informed resourcing, not a performance record.']
  last_used_at     date [note: 'Most meaningful for technology type — signals recency of hands-on use.
                         Also captured for practices and methodologies where relevant.
                         Updated automatically when verified evidence tagged with this
                         competency is created for this user.']
  is_inferred      bool [not null, default: false,
                         note: 'true  = derived from evidence_competencies on verified evidence.
                         false = set explicitly by the user or via external integration.
                         Inferred competencies may warrant different UI treatment —
                         e.g. "based on your evidence" vs "you stated this directly".']
  external_id      text [note: 'Assessment or record ID from an external platform.
                         e.g. Pluralsight IQ score ID, Coursera certificate ID.']
  external_source  text [note: 'e.g. pluralsight, coursera, linkedin_learning']
}


// ── Credentials ───────────────────────────────────────────────────────────
//
// Third-party verified certifications and qualifications.
// Distinct from competencies in a meaningful way: a credential is a verified
// external fact, not a self-assessed proficiency level.
//
// In bid and resourcing contexts, "holds Prince2 Practitioner (verified, expires 2027)"
// is a materially different claim to "rates themselves as confident with Prince2."
// Both are valuable. They should not be conflated.

Table credentials {
  id              int  [primary key]
  user_id         int  [not null, ref: > users.id]
  name            text [not null,
                        note: 'e.g. Prince2 Practitioner, PSM I, AWS Solutions Architect Associate,
                        Google UX Design Certificate, SC Cleared (if treated as a credential
                        rather than via user_clearances — for non-security credentials only)']
  issuer          text [not null, note: 'e.g. AXELOS, Scrum.org, AWS, Google, BCS']
  issued_at       date
  expires_at      date [note: 'NULL = does not expire. Application should alert before expiry.']
  credential_url  text [note: 'Verification URL if the issuer provides one.
                        e.g. Credly badge link, Acclaim, LinkedIn credential verification.']
  external_id     text [note: 'Certificate ID or credential ID from the issuer.
                        Used for verification and deduplication.']
  note: 'Security clearances are managed separately in user_clearances because they
  have specific visibility and access control implications. Do not duplicate them here.'
}


// ── Relationships between users ────────────────────────────────────────────
//
// Directed edges. "actor IS relationship_type TO target"
// e.g. actor_id=5 is line_manager of target_id=12
//
// Temporal — end_date NULL means currently active.
// To change a relationship, set end_date on the existing row and insert a new one.
// The full history is required for audit and for questions like
// "who was this person's manager when this evidence was submitted?"

Table user_relationships {
  id                int  [primary key]
  actor_id          int  [not null, ref: > users.id]
  target_id         int  [not null, ref: > users.id]
  relationship_type enum [not null,
                          note: 'line_manager | technical_manager | mentor | mentee | peer']
  start_date        date
  end_date          date [note: 'NULL = currently active']
  note: 'Append-only. Never update — close the old row and open a new one.'
}


// ── Projects ──────────────────────────────────────────────────────────────
//
// minimum_clearance_id enforces project visibility at the query layer.
// A user whose clearance rank is below the project minimum should not be
// able to see the project exists at all — not just its contents.
// This must be enforced in every query returning project data, not only in the UI.
//
// is_name_classified handles the edge case where even the project name is sensitive.
// When true: users who meet minimum_clearance see code_name only.
//            users who are explicit project_members see the full name.
//            users below minimum_clearance see nothing.

Table projects {
  id                   int  [primary key]
  organisation_id      int  [not null, ref: > organisations.id]
  name                 text [not null]
  short_name           text
  code_name            text [note: 'For sensitive projects where the real name is classified.']
  is_name_classified   bool [not null, default: false,
                             note: 'If true, name is hidden even from users who meet minimum_clearance.
                             Only explicit project_members see the full name.']
  minimum_clearance_id int  [ref: > clearance_levels.id,
                             note: 'NULL = no clearance required.
                             Users below this clearance rank receive no indication
                             the project exists.']
}

Table project_members {
  id           int  [primary key]
  project_id   int  [not null, ref: > projects.id]
  user_id      int  [not null, ref: > users.id]
  project_role enum [not null,
                     note: 'developer | tech_lead | delivery_manager | analyst |
                     designer | project_manager']
  start_date   date [not null]
  end_date     date [note: 'NULL = currently active.
                    History is required to determine who was on a project at the time
                    evidence was submitted — affects endorsement routing and audit queries.']
}


// ── Evidence ──────────────────────────────────────────────────────────────
//
// The core of the system. A STAR entry authored by a user claiming a specific
// SFIA skill at a specific level, optionally in the context of a project.
//
// Versioning: when a user revises evidence (typically after a flagged endorsement),
// the original row is not mutated. A new row is inserted with parent_id pointing
// to the previous version and version incremented. Endorsements reference specific
// evidence rows and are therefore naturally version-scoped.
//
// The current version of a piece of evidence is the row with the highest version
// in a parent chain (or the original row if parent_id is NULL and no children exist).

Table evidence {
  id                  int  [primary key]
  user_id             int  [not null, ref: > users.id]
  project_id          int  [ref: > projects.id,
                            note: 'NULL = non-project work (CPD, internal initiatives, etc.)']
  sfia_skill_level_id int  [not null, ref: > sfia_skill_levels.id,
                            note: 'The specific SFIA skill AND level the employee is claiming.
                            The UI should show the level descriptor so the user can make
                            an informed claim before submitting.']
  parent_id           int  [ref: > evidence.id,
                            note: 'NULL = original version.
                            Set when the user revises after receiving a flagged endorsement.']
  version             int  [not null, default: 1]
  situation           text [not null]
  task                text [not null]
  action              text [not null]
  result              text [not null]
  status              enum [not null, default: 'draft',
                            note: 'draft | submitted | verified
                            draft      Visible only to the author.
                            submitted  Pending endorsements. Visible to assigned endorsers.
                            verified   Endorsement threshold met. Locked — no further edits.
                                       A new version must be created to make changes.']
}

// Competencies tagged on a piece of evidence.
// When evidence is verified, the application upserts a competencies row for
// the author (or updates last_used_at if one already exists) for each tag.
// This is how is_inferred competencies are created and kept current.

Table evidence_competencies {
  id               int  [primary key]
  evidence_id      int  [not null, ref: > evidence.id]
  competency_name  text [not null,
                         note: 'Should match the normalised name used in competencies.name.
                         The UI autocomplete should draw from existing competency names
                         to avoid fragmentation (React vs ReactJS vs React.js).']
  competency_type  enum [not null,
                         note: 'technology | practice | methodology
                         Carried through from the tag so queries can filter by type
                         without joining to competencies.']
}


// ── Endorsements ──────────────────────────────────────────────────────────
//
// One row per (evidence, endorser) pair. Rows are created automatically when
// evidence is submitted, based on the organisation's endorsement_routing_policy,
// plus any people the author adds manually.
//
// Routing logic applied at submission time:
//   project_only           Active project co-members with sufficient clearance
//   project_and_managers   Above + the author's active line/technical managers and mentors
//   managers_only          Only the author's active managers and mentors
//   org_wide               Any member of the organisation (not recommended for most orgs)
//
// Notes are private — visible only to the evidence author, not to other endorsers
// or to managers. This keeps the channel honest without creating peer visibility
// into disagreements.

Table endorsements {
  id            int  [primary key]
  evidence_id   int  [not null, ref: > evidence.id]
  endorser_id   int  [not null, ref: > users.id]
  is_suggested  bool [not null, default: true,
                      note: 'true  = system routed based on organisation policy.
                      false = author manually added this person.']
  status        enum [not null, default: 'pending',
                      note: 'pending | endorsed | skipped | flagged

                      pending    Endorser has not yet responded.
                      endorsed   Endorser confirms the evidence is accurate as described.
                      skipped    Endorser does not feel qualified to comment on this evidence.
                                 Does not block verification. No negative inference.
                      flagged    Endorser has concerns about the accuracy or claimed level.
                                 Triggers the note field. Does not automatically block
                                 verification — the threshold calculation determines whether
                                 enough non-flagged endorsements exist to proceed.
                                 The author may revise (creating a new version) which resets
                                 the endorsement cycle on the new version.']
  note          text [note: 'Optional. Private message from endorser to evidence author.
                      Visible only to the author. Not visible to other endorsers or managers.
                      Intended for constructive guidance, not public critique.']
  responded_at  date

  indexes {
    (evidence_id, endorser_id) [unique,
      note: 'One response per endorser per evidence version.
      A new evidence version (via parent_id) gets its own endorsement rows.']
  }
}


// ── Feedback ──────────────────────────────────────────────────────────────
//
// Freeform feedback. Three valid configurations:
//   subject_id set, project_id null    General feedback about a person.
//   subject_id null, project_id set    Project-level feedback, no individual target.
//   subject_id set, project_id set     Feedback about a person in a project context.
//   Both null                          Invalid. Rejected at application layer.
//
// Anonymous feedback:
//   author_id is always stored in the database.
//   If is_anonymous is true, author_id is hidden from the subject but visible
//   to reviewed_by. The reviewer can identify the author if content is abusive.
//
// Routing edge cases — detected at submission time, reviewed_by set accordingly:
//   If author IS reviewed_by (manager submitting about themselves): route up.
//   If subject IS reviewed_by (manager receiving feedback from their own team): route up.
//   "Route up" means assign the manager's current line_manager as reviewed_by.

Table feedback {
  id              int  [primary key]
  author_id       int  [not null, ref: > users.id]
  subject_id      int  [ref: > users.id,
                        note: 'NULL only when this is pure project-level feedback.']
  project_id      int  [ref: > projects.id,
                        note: 'NULL for general feedback not tied to a project.']
  reviewed_by_id  int  [ref: > users.id,
                        note: 'The manager who must approve before subject sees it.
                        NULL until assigned at submission time.
                        When organisations.feedback_review_required is false,
                        feedback goes straight to visible_to_subject and this stays NULL.']
  is_anonymous    bool [not null, default: false,
                        note: 'If true, author_id is hidden from the subject.
                        The reviewer always sees the author regardless of this flag.
                        Users should feel safe being honest — anonymity is not performative.']
  visibility      enum [not null, default: 'pending_review',
                        note: 'pending_review | approved | rejected | visible_to_subject

                        pending_review      Reviewer has not yet acted.
                        approved            Reviewer approved. Now visible to subject.
                        rejected            Reviewer rejected (e.g. abusive or bad-faith content).
                                            Subject never sees it. Author may be notified
                                            without revealing the subject.
                        visible_to_subject  Approval not required (feedback_review_required = false)
                                            or reviewer approved and subject can now see it.']
  content         text [not null]
}


// ── Goals ─────────────────────────────────────────────────────────────────
//
// Intentionally lightweight. A goal is a statement of intent, not an OKR.
// Progress is measured by the body of linked verified evidence, not a percentage slider.
//
// Visibility defaults to private. Sharing with a manager is always the user's choice.
// This is especially important given that some users may find goal-setting tied to
// anxiety or performance pressure — the tool should feel like it works for them,
// not against them.

Table goals {
  id           int  [primary key]
  user_id      int  [not null, ref: > users.id]
  title        text [not null]
  description  text [note: 'Optional and deliberately unstructured.
                    A goal can be as simple as a title.']
  target_date  date [note: 'Optional — some goals are open-ended.']
  status       enum [not null, default: 'active',
                     note: 'active | achieved | abandoned']
  visibility   enum [not null, default: 'private',
                     note: 'private | shared_with_manager
                     private            Only the user can see this goal.
                     shared_with_manager  The users current line manager can also see it.
                     Sharing is always the users explicit choice. Never automatic.']
}

// Links evidence to goals. Progress toward a goal is the body of verified
// evidence linked here. The application counts only verified evidence toward
// progress but displays all linked evidence so the user can see what is pending.

Table goal_evidence {
  id          int [primary key]
  goal_id     int [not null, ref: > goals.id]
  evidence_id int [not null, ref: > evidence.id]

  indexes {
    (goal_id, evidence_id) [unique]
  }
}


// ── References ────────────────────────────────────────────────────────────

Ref: sfia_skills.organisation_id > organisations.id
Ref: sfia_skill_levels.sfia_skill_id > sfia_skills.id
Ref: sfia_skill_levels.organisation_id > organisations.id
Ref: ddat_role_requirements.ddat_role_id > ddat_roles.id
Ref: ddat_role_requirements.sfia_skill_level_id > sfia_skill_levels.id
Ref: organisations.id < users.organisation_id
Ref: user_clearances.user_id > users.id
Ref: user_clearances.clearance_level_id > clearance_levels.id
Ref: users.current_clearance_id - user_clearances.id
Ref: organisations.id < job_grades.organisation_id
Ref: job_grades.maps_to_ddat_role_id > ddat_roles.id
Ref: job_grade_requirements.job_grade_id > job_grades.id
Ref: job_grade_requirements.sfia_skill_level_id > sfia_skill_levels.id
Ref: user_grade_assignments.user_id > users.id
Ref: user_grade_assignments.job_grade_id > job_grades.id
Ref: competencies.user_id > users.id
Ref: credentials.user_id > users.id
Ref: user_relationships.actor_id > users.id
Ref: user_relationships.target_id > users.id
Ref: projects.organisation_id > organisations.id
