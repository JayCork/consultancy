# =============================================================================
# ROOT .env.example
# Copy this file to .env and fill in the values.
# This is the single source of truth for all environment variables in the
# monorepo. All apps and packages load from this file via dotenvx.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local dev: spin up a Postgres instance (e.g. `docker compose up`) and use:
#   postgres://<user>:<password>@localhost:5432/<database>
# Production: TODO
DATABASE_URL=postgres://basic_dev:butter_iron_knife@localhost:5432/consultancy_hub

# ── apps/api ──────────────────────────────────────────────────────────────────

# Port the API server listens on.
# Default: 5173. Change if that port is already in use locally.
PORT=5173

# Node environment. Use "development" locally, "production" in deployed envs.
NODE_ENV=development

# Public base URL of the API server (used by better-auth for redirect URLs).
# Local dev: http://localhost:<PORT>
# Production: your deployed API URL, e.g. https://api.example.com
BETTER_AUTH_URL=http://localhost:5173

# Secret used by better-auth to sign session tokens. Must be a long random string.
# Generate one with: openssl rand -hex 32
# Never reuse secrets between environments.
BETTER_AUTH_SECRET=<generate-with: openssl rand -hex 32>

# Public base URL of the web frontend (used by the API as a trusted CORS origin).
# Local dev: http://localhost:3000
# Production: your deployed web URL, e.g. https://app.example.com
WEB_URL=http://localhost:3000

# ── apps/web ──────────────────────────────────────────────────────────────────

# URL of the API server, exposed to the browser via Vite.
# Must match BETTER_AUTH_URL / the API origin above.
VITE_API_URL=http://localhost:5173
