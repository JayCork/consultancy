  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.55.1",
    "@types/node": "^24.10.11",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
